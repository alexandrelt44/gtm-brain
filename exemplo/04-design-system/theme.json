      },
      "two": {
        "value": "oklch(0.65 0.07 136)",
        "hex": "#7C9A6E",
        "role": "Sálvia. Série secundária de gráficos"
      }
    },
    "neutral": {
      "0": { "value": "oklch(0.98 0.01 81)", "hex": "#FBF8F3", "role": "Fundo da página" },
      "50": { "value": "oklch(1.00 0 0)", "hex": "#FFFFFF", "role": "Fundo de card e da barra de navegação" },
      "100": { "value": "oklch(0.94 0.02 80)", "hex": "#F1E9DC", "role": "Fundo de seção (igual à Areia)" },
      "200": { "value": "oklch(0.89 0.02 78)", "hex": "#E4DACB", "role": "Borda de card e de campo, divisórias" },
