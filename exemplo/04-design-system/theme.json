      "700": { "value": "oklch(0.34 0.01 72)", "hex": "#3D3832", "role": "Texto corrido, texto do badge" },
      "900": { "value": "oklch(0.23 0.01 67)", "hex": "#211D19", "role": "Títulos; tom das sombras" }
